# Generate a narrowly changed translation unit; never edit ignored framework refs.
function(sm2_framework_capture_source source_file output_dir)
  file(SHA256 "${source_file}" source_hash)
  if(NOT source_hash STREQUAL "38871e6560abe7feb5c59fb1e13fb77f2b3c269e530204ccdc254305608ff126")
    message(FATAL_ERROR "Unsupported framework D3D12Hook.cpp; capture compatibility requires source review")
  endif()
  file(READ "${source_file}" source)
  set(needle "const auto original_bytes = utility::get_original_bytes(d3d12_create_device);")
  string(FIND "${source}" "${needle}" first)
  string(LENGTH "${needle}" needle_length)
  math(EXPR after "${first}+${needle_length}")
  string(SUBSTRING "${source}" ${after} -1 remaining)
  string(FIND "${remaining}" "${needle}" second)
  if(first LESS 0 OR NOT second LESS 0)
    message(FATAL_ERROR "Expected exactly one dummy-device byte inspection")
  endif()
  set(replacement "const auto original_bytes = sm2_capture_compat::dummy_original_bytes(reinterpret_cast<uintptr_t>(d3d12_create_device), [&] { return utility::get_original_bytes(d3d12_create_device); }, [](uintptr_t target, bool retained, const char* module) { spdlog::info(\"FrameworkCaptureCompat: dummy target={:x} module={} retain_hook={}\", target, module, retained); });")
  string(REPLACE "${needle}" "${replacement}" patched "${source}")
  file(MAKE_DIRECTORY "${output_dir}")
  file(WRITE "${output_dir}/D3D12Hook.cpp" "#include \"FrameworkCaptureCompatibility.h\"\n${patched}")
  # The CPU fixture compiles the exact generated native dummy-device branch.
  string(FIND "${patched}" "${replacement}" begin)
  string(FIND "${patched}" "    spdlog::info(\"Dummy device: {:x}\"" end)
  if(begin LESS 0 OR end LESS_EQUAL begin)
    message(FATAL_ERROR "Unsupported dummy-device fixture boundaries")
  endif()
  math(EXPR length "${end}-${begin}")
  string(SUBSTRING "${patched}" ${begin} ${length} dummy_block)
  file(WRITE "${output_dir}/framework_capture_dummy.inc" "${dummy_block}")
endfunction()
